+		if err := writeCommandDiscovery(&output, path); err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(output.String(), "--no-environment") {
+			t.Fatalf("help %v does not advertise --no-environment: %s", path, output.String())
+		}
+	}
