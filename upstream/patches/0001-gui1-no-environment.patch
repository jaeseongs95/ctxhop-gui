+		{"native-session", "--no-environment", "--no-workspace-context"},
+	} {
+		options, err := parseResumeOptions(args)
+		if err != nil || !options.noEnvironment || options.session != "native-session" {
+			t.Fatalf("parse %v = %+v, %v", args, options, err)
+		}
+	}
