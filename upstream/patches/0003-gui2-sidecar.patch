@@ -0,0 +1,441 @@
+package syncer
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"crypto/ecdh"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"os"
+	"path"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/CCCCY-ci/ctxhop/internal/crypto"
+	"github.com/CCCCY-ci/ctxhop/internal/remote"
+)
+
+// A session sidecar is the set of files an agent keeps beside one native
+// session file. For Claude Code that is the <sessionId> folder next to
+// <sessionId>.jsonl, holding subagent transcripts and saved tool results.
+//
+// It travels as one encrypted zip per device branch and is only ever written
+// back into the same folder beside the restored session file. Files are
+// copied byte for byte; paths inside them are not localised.
+const (
+	MaxSidecarFiles          = 20000
+	MaxSidecarFileBytes      = 512 << 20
+	MaxSidecarBytes          = 1 << 30
+	maxEncryptedSidecarBytes = MaxSidecarBytes + 64<<20
+	sidecarFormat            = "ctxhop-sidecar/1"
+)
+
+var (
+	// ErrNoSidecar reports a device branch that has no sidecar object, for
+	// example one pushed by a release that did not carry sidecars.
+	ErrNoSidecar         = errors.New("syncer: session has no sidecar")
+	ErrInvalidSidecar    = errors.New("syncer: invalid session sidecar")
+	ErrUnsafeSidecarPath = errors.New("syncer: unsafe sidecar path")
+)
+
+// SidecarFile is one regular file, relative to the sidecar folder with
+// forward slashes.
+type SidecarFile struct {
+	Path    string
+	Content []byte
+}
+
+// SidecarApplyResult counts what ApplySidecar did.
+type SidecarApplyResult struct {
+	Written   int
+	Unchanged int
+	BackedUp  int
+}
+
+// CaptureSidecar reads every regular file below dir. A missing folder is an
+// empty sidecar. Links and other reparse points are skipped and never
+// followed.
+func CaptureSidecar(ctx context.Context, dir string) ([]SidecarFile, error) {
+	info, err := os.Lstat(dir)
+	if errors.Is(err, fs.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("syncer: read sidecar folder: %w", err)
+	}
+	if info.Mode().Type() != fs.ModeDir {
+		return nil, fmt.Errorf("%w: %s is not a plain folder", ErrUnsafeSidecarPath, filepath.Base(dir))
+	}
+	var files []SidecarFile
+	var total int64
+	err = filepath.WalkDir(dir, func(current string, entry fs.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		if current == dir {
+			return nil
+		}
+		kind := entry.Type()
+		if kind == fs.ModeDir {
+			return nil
+		}
+		if !kind.IsRegular() {
+			// Symlinks, junctions and other reparse points are not session data.
+			if kind&fs.ModeDir != 0 {
+				return fs.SkipDir
+			}
+			return nil
+		}
+		relative, err := filepath.Rel(dir, current)
+		if err != nil {
+			return err
+		}
+		relative = filepath.ToSlash(relative)
+		if !ValidSidecarPath(relative) {
+			return fmt.Errorf("%w: %q", ErrUnsafeSidecarPath, relative)
+		}
+		if len(files) >= MaxSidecarFiles {
+			return fmt.Errorf("%w: more than %d files", ErrInvalidSidecar, MaxSidecarFiles)
+		}
+		content, err := os.ReadFile(current)
+		if err != nil {
+			return err
+		}
+		if len(content) > MaxSidecarFileBytes {
+			return fmt.Errorf("%w: %s is larger than %d bytes", ErrInvalidSidecar, relative, MaxSidecarFileBytes)
+		}
+		total += int64(len(content))
+		if total > MaxSidecarBytes {
+			return fmt.Errorf("%w: larger than %d bytes", ErrInvalidSidecar, MaxSidecarBytes)
+		}
+		files = append(files, SidecarFile{Path: relative, Content: content})
+		return nil
+	})
+	if err != nil {
+		return nil, fmt.Errorf("syncer: capture sidecar: %w", err)
+	}
+	sort.Slice(files, func(i, j int) bool { return files[i].Path < files[j].Path })
+	return files, nil
+}
+
+// MarshalSidecar encodes files as a deflated zip.
+func MarshalSidecar(files []SidecarFile) ([]byte, error) {
+	if err := validateSidecar(files); err != nil {
+		return nil, err
+	}
+	var buffer bytes.Buffer
+	writer := zip.NewWriter(&buffer)
+	stamp := time.Date(1980, 1, 1, 0, 0, 0, 0, time.UTC)
+	for _, file := range files {
+		entry, err := writer.CreateHeader(&zip.FileHeader{Name: file.Path, Method: zip.Deflate, Modified: stamp})
+		if err != nil {
+			return nil, err
+		}
+		if _, err := entry.Write(file.Content); err != nil {
+			return nil, err
+		}
+	}
+	if err := writer.SetComment(sidecarFormat); err != nil {
+		return nil, err
+	}
+	if err := writer.Close(); err != nil {
+		return nil, err
+	}
+	return buffer.Bytes(), nil
+}
+
+// ParseSidecar decodes and validates a sidecar zip.
+func ParseSidecar(data []byte) ([]SidecarFile, error) {
+	reader, err := zip.NewReader(bytes.NewReader(data), int64(len(data)))
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrInvalidSidecar, err)
+	}
+	if reader.Comment != sidecarFormat {
+		return nil, fmt.Errorf("%w: unknown format", ErrInvalidSidecar)
+	}
+	if len(reader.File) > MaxSidecarFiles {
+		return nil, fmt.Errorf("%w: too many files", ErrInvalidSidecar)
+	}
+	files := make([]SidecarFile, 0, len(reader.File))
+	var total uint64
+	for _, entry := range reader.File {
+		if !ValidSidecarPath(entry.Name) || !entry.Mode().IsRegular() {
+			return nil, fmt.Errorf("%w: %q", ErrUnsafeSidecarPath, entry.Name)
+		}
+		if entry.UncompressedSize64 > MaxSidecarFileBytes {
+			return nil, fmt.Errorf("%w: %s is too large", ErrInvalidSidecar, entry.Name)
+		}
+		total += entry.UncompressedSize64
+		if total > MaxSidecarBytes {
+			return nil, fmt.Errorf("%w: too large", ErrInvalidSidecar)
+		}
+		body, err := entry.Open()
+		if err != nil {
+			return nil, fmt.Errorf("%w: %v", ErrInvalidSidecar, err)
+		}
+		content, readErr := io.ReadAll(io.LimitReader(body, int64(entry.UncompressedSize64)+1))
+		closeErr := body.Close()
+		if readErr != nil || closeErr != nil || uint64(len(content)) != entry.UncompressedSize64 {
+			return nil, fmt.Errorf("%w: %s is damaged", ErrInvalidSidecar, entry.Name)
+		}
+		files = append(files, SidecarFile{Path: entry.Name, Content: content})
+	}
+	if err := validateSidecar(files); err != nil {
+		return nil, err
+	}
+	return files, nil
+}
+
+// validateSidecar rejects unsafe paths and names that would land on the same
+// file on a case-insensitive file system, or on a file and a folder at once.
+func validateSidecar(files []SidecarFile) error {
+	if len(files) > MaxSidecarFiles {
+		return fmt.Errorf("%w: too many files", ErrInvalidSidecar)
+	}
+	seen := make(map[string]bool, len(files))
+	var total int64
+	for _, file := range files {
+		if !ValidSidecarPath(file.Path) {
+			return fmt.Errorf("%w: %q", ErrUnsafeSidecarPath, file.Path)
+		}
+		total += int64(len(file.Content))
+		if len(file.Content) > MaxSidecarFileBytes || total > MaxSidecarBytes {
+			return fmt.Errorf("%w: too large", ErrInvalidSidecar)
+		}
+		key := strings.ToLower(file.Path)
+		if _, exists := seen[key]; exists {
+			return fmt.Errorf("%w: duplicate path %q", ErrInvalidSidecar, file.Path)
+		}
+		seen[key] = true
+	}
+	for _, file := range files {
+		for parent := path.Dir(file.Path); parent != "."; parent = path.Dir(parent) {
+			if isFile, exists := seen[strings.ToLower(parent)]; exists && isFile {
+				return fmt.Errorf("%w: %q is both a file and a folder", ErrInvalidSidecar, parent)
+			}
+		}
+	}
+	return nil
+}
+
+// ValidSidecarPath accepts a relative path with forward slashes whose parts
+// are plain Windows and POSIX file names.
+func ValidSidecarPath(value string) bool {
+	if value == "" || len(value) > 1024 || !utf8.ValidString(value) || path.Clean(value) != value || strings.HasPrefix(value, "/") {
+		return false
+	}
+	for _, part := range strings.Split(value, "/") {
+		if part == "" || part == "." || part == ".." || len(part) > 255 || strings.HasSuffix(part, ".") || strings.HasSuffix(part, " ") {
+			return false
+		}
+		for _, r := range part {
+			if r < 0x20 || r == 0x7f || strings.ContainsRune(`<>:"\|?*`, r) {
+				return false
+			}
+		}
+		base := strings.ToUpper(part)
+		if dot := strings.IndexByte(base, '.'); dot >= 0 {
+			base = base[:dot]
+		}
+		switch base {
+		case "CON", "PRN", "AUX", "NUL", "CONIN$", "CONOUT$":
+			return false
+		}
+		if len(base) == 4 && (strings.HasPrefix(base, "COM") || strings.HasPrefix(base, "LPT")) && base[3] >= '0' && base[3] <= '9' {
+			return false
+		}
+	}
+	return true
+}
+
+// PutSidecar publishes this device's sidecar for one session. An empty file
+// list is published too, so a later restore does not reuse stale files.
+func PutSidecar(ctx context.Context, store remote.Remote, recipient *ecdh.PublicKey, layout ObjectLayout, files []SidecarFile) error {
+	if ctx == nil || store == nil || recipient == nil {
+		return errors.New("syncer: context, remote store and recipient key are required")
+	}
+	key, err := layout.SidecarKey()
+	if err != nil {
+		return err
+	}
+	plaintext, err := MarshalSidecar(files)
+	if err != nil {
+		return err
+	}
+	sealed, err := crypto.Encrypt(recipient, key, plaintext)
+	if err != nil {
+		return fmt.Errorf("syncer: encrypt sidecar: %w", err)
+	}
+	if err := store.Put(ctx, key, bytes.NewReader(sealed), int64(len(sealed))); err != nil {
+		return fmt.Errorf("syncer: publish sidecar: %w", err)
+	}
+	return nil
+}
+
+// ReadSidecar reads one device branch's sidecar. It returns ErrNoSidecar when
+// that branch has none.
+func ReadSidecar(ctx context.Context, store remote.Remote, layout ObjectLayout, identities []*ecdh.PrivateKey) ([]SidecarFile, error) {
+	if ctx == nil || store == nil {
+		return nil, errors.New("syncer: context and remote store are required")
+	}
+	if err := validateIdentities(identities); err != nil {
+		return nil, err
+	}
+	key, err := layout.SidecarKey()
+	if err != nil {
+		return nil, err
+	}
+	reader, err := store.Get(ctx, key)
+	if errors.Is(err, remote.ErrNotFound) {
+		return nil, ErrNoSidecar
+	}
+	if err != nil {
+		return nil, fmt.Errorf("syncer: read sidecar: %w", err)
+	}
+	sealed, readErr := io.ReadAll(io.LimitReader(reader, maxEncryptedSidecarBytes+1))
+	closeErr := reader.Close()
+	if readErr != nil {
+		return nil, fmt.Errorf("syncer: read sidecar: %w", readErr)
+	}
+	if closeErr != nil {
+		return nil, fmt.Errorf("syncer: close sidecar: %w", closeErr)
+	}
+	if len(sealed) > maxEncryptedSidecarBytes {
+		return nil, fmt.Errorf("%w: too large", ErrInvalidSidecar)
+	}
+	var lastErr error
+	for _, identity := range identities {
+		plaintext, openErr := crypto.Decrypt(identity, key, sealed)
+		if openErr == nil {
+			return ParseSidecar(plaintext)
+		}
+		lastErr = openErr
+	}
+	return nil, fmt.Errorf("syncer: open sidecar: %w", lastErr)
+}
+
+// ApplySidecar writes files into dir, creating it if needed. A file whose
+// bytes already match is left alone, a different one is replaced, and local
+// files that the sidecar does not list are kept. Existing links or reparse
+// points on the way are refused rather than followed. When backupDir is set,
+// each replaced file is first copied there under the same relative path; the
+// folder must not exist yet and is created only when something is replaced.
+func ApplySidecar(dir string, files []SidecarFile, backupDir string) (SidecarApplyResult, error) {
+	var result SidecarApplyResult
+	if err := validateSidecar(files); err != nil {
+		return result, err
+	}
+	if backupDir != "" {
+		if _, err := os.Lstat(backupDir); !errors.Is(err, fs.ErrNotExist) {
+			return result, fmt.Errorf("%w: backup folder already exists", ErrUnsafeSidecarPath)
+		}
+	}
+	if len(files) == 0 {
+		return result, nil
+	}
+	if err := plainFolder(dir, true); err != nil {
+		return result, err
+	}
+	for _, file := range files {
+		target := filepath.Join(dir, filepath.FromSlash(file.Path))
+		if !strings.HasPrefix(target, dir+string(filepath.Separator)) {
+			return result, fmt.Errorf("%w: %q", ErrUnsafeSidecarPath, file.Path)
+		}
+		folder := dir
+		parts := strings.Split(file.Path, "/")
+		for _, part := range parts[:len(parts)-1] {
+			folder = filepath.Join(folder, part)
+			if err := plainFolder(folder, true); err != nil {
+				return result, err
+			}
+		}
+		info, err := os.Lstat(target)
+		switch {
+		case errors.Is(err, fs.ErrNotExist):
+		case err != nil:
+			return result, fmt.Errorf("syncer: inspect sidecar file: %w", err)
+		case !info.Mode().IsRegular():
+			return result, fmt.Errorf("%w: %s is not a regular file", ErrUnsafeSidecarPath, file.Path)
+		default:
+			current, err := os.ReadFile(target)
+			if err != nil {
+				return result, fmt.Errorf("syncer: read sidecar file: %w", err)
+			}
+			if bytes.Equal(current, file.Content) {
+				result.Unchanged++
+				continue
+			}
+			if backupDir != "" {
+				if err := backupFile(backupDir, file.Path, current); err != nil {
+					return result, fmt.Errorf("syncer: back up sidecar file %s: %w", file.Path, err)
+				}
+				result.BackedUp++
+			}
+		}
+		if err := replaceFile(folder, target, file.Content); err != nil {
+			return result, fmt.Errorf("syncer: write sidecar file %s: %w", file.Path, err)
+		}
+		result.Written++
+	}
+	return result, nil
+}
+
+func backupFile(backupDir, relative string, content []byte) error {
+	target := filepath.Join(backupDir, filepath.FromSlash(relative))
+	if err := os.MkdirAll(filepath.Dir(target), 0o700); err != nil {
+		return err
+	}
+	file, err := os.OpenFile(target, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return err
+	}
+	_, writeErr := file.Write(content)
+	syncErr := file.Sync()
+	return errors.Join(writeErr, syncErr, file.Close())
+}
+
+func plainFolder(dir string, create bool) error {
+	info, err := os.Lstat(dir)
+	if errors.Is(err, fs.ErrNotExist) && create {
+		if err := os.Mkdir(dir, 0o700); err != nil && !errors.Is(err, fs.ErrExist) {
+			return fmt.Errorf("syncer: create sidecar folder: %w", err)
+		}
+		info, err = os.Lstat(dir)
+	}
+	if err != nil {
+		return fmt.Errorf("syncer: inspect sidecar folder: %w", err)
+	}
+	if info.Mode().Type() != fs.ModeDir {
+		return fmt.Errorf("%w: %s is not a plain folder", ErrUnsafeSidecarPath, filepath.Base(dir))
+	}
+	return nil
+}
+
+func replaceFile(folder, target string, content []byte) error {
+	temp, err := os.CreateTemp(folder, ".ctxhop-sidecar-*")
+	if err != nil {
+		return err
+	}
+	name := temp.Name()
+	_, writeErr := temp.Write(content)
+	syncErr := temp.Sync()
+	closeErr := temp.Close()
+	if err := errors.Join(writeErr, syncErr, closeErr); err != nil {
+		os.Remove(name)
+		return err
+	}
+	if err := os.Rename(name, target); err != nil {
+		os.Remove(name)
+		return err
+	}
+	return nil
+}
