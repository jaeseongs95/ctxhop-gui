diff --git a/cmd/ctxhop/resume_sidecar_test.go b/cmd/ctxhop/resume_sidecar_test.go
new file mode 100644
index 0000000..49998be
--- /dev/null
+++ b/cmd/ctxhop/resume_sidecar_test.go
@@ -0,0 +1,182 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/CCCCY-ci/ctxhop/internal/adapter"
+	"github.com/CCCCY-ci/ctxhop/internal/crypto"
+	"github.com/CCCCY-ci/ctxhop/internal/remote"
+	"github.com/CCCCY-ci/ctxhop/internal/syncer"
+)
+
+// Push a Claude Code session with its companion folder (subagent transcripts,
+// saved tool results) and restore it the way the GUI does, into another agent
+// home, through the real encrypted remote and native restore path.
+func TestClaudeResumeRestoresSessionSidecar(t *testing.T) {
+	ctx := context.Background()
+	projectRoot, homeA, homeB := t.TempDir(), t.TempDir(), t.TempDir()
+	configDir, remoteRoot := t.TempDir(), t.TempDir()
+	t.Setenv("CODEX_HOME", filepath.Join(t.TempDir(), "missing-codex"))
+	t.Setenv("CTXHOP_CONFIG_DIR", configDir)
+	t.Setenv("CLAUDE_CONFIG_DIR", homeB)
+	t.Chdir(projectRoot)
+	runResumeGit(t, projectRoot, "init", "-q")
+	store, err := remote.NewDir(remoteRoot)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cleanupResumeRemoteRoot(t, remoteRoot)
+	keyfile, _, err := crypto.NewKeyfile("passphrase")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := syncer.PublishKeyfile(ctx, store, keyfile); err != nil {
+		t.Fatal(err)
+	}
+	dataKey, err := keyfile.UnlockWithPassphrase("passphrase")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer dataKey.Close()
+	public, err := keyfile.IdentityPublicKey()
+	if err != nil {
+		t.Fatal(err)
+	}
+	identifierKey, err := dataKey.IdentifierKey()
+	if err != nil {
+		t.Fatal(err)
+	}
+	const identity = "manual:sidecar-regression"
+	c := newCodexRoundTripConfig(t, configDir, remoteRoot, public, identifierKey, "devicea", projectRoot, identity)
+	projectID, err := crypto.ProjectID(identifierKey, identity)
+	if err != nil {
+		t.Fatal(err)
+	}
+	const nativeID = "0b5d6c1e-2f3a-4b5c-8d9e-0f1a2b3c4d5e"
+	source, target := adapter.Layout{Home: homeA}, adapter.Layout{Home: homeB}
+	record, err := json.Marshal(map[string]any{"type": "user", "cwd": projectRoot, "sessionId": nativeID, "timestamp": "2026-09-27T10:00:00Z", "message": map[string]any{"role": "user", "content": "sidecar-parent-marker"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := source.ReplaceSession(projectRoot, nativeID, [][]byte{record}); err != nil {
+		t.Fatal(err)
+	}
+	companion := map[string]string{
+		"subagents/agent-a1.jsonl":     "{\"type\":\"user\",\"isSidechain\":true,\"message\":\"SUBAGENT-MARKER\"}\n",
+		"subagents/agent-a1.meta.json": "{\"agentType\":\"worker\"}",
+		"tool-results/toolu_1.txt":     "saved tool output",
+	}
+	for name, body := range companion {
+		path := filepath.Join(source.SidecarDir(projectRoot, nativeID), filepath.FromSlash(name))
+		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	refs, err := source.DiscoverSessions(projectRoot)
+	if err != nil || len(refs) != 1 {
+		t.Fatalf("source sessions = %v, %v", refs, err)
+	}
+	installation := adapter.Installation{DataDir: homeA, Version: "2.1.0", Compatibility: adapter.CompatFull}
+	space := adapter.PathSpace{ProjectRoot: projectRoot, AgentHome: homeA}
+	summary := pushDiscoveredSessionsWithOptions(ctx, c.Device.ID, identifierKey, projectID, identity, source, installation, space, store, public, newCodexRoundTripPusher(t, configDir), configDir, projectRoot, refs, pushSessionOptions{})
+	if summary.Pushed != 1 || summary.Failed != 0 {
+		t.Fatalf("fixture push = %+v", summary)
+	}
+	legacyID, err := crypto.SessionID(identifierKey, projectID, nativeID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	objectLayout, err := syncer.NewObjectLayout(projectID, legacyID, c.Device.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sidecarKey, _ := objectLayout.SidecarKey()
+	sealed, err := os.ReadFile(filepath.Join(remoteRoot, filepath.FromSlash(sidecarKey)))
+	if err != nil || bytes.Contains(sealed, []byte("SUBAGENT-MARKER")) {
+		t.Fatalf("pushed sidecar must exist and be encrypted: %v", err)
+	}
+
+	// The GUI passes the legacy remote ID from `list --json` with --agent.
+	args := []string{"resume", "--json", "--agent", "claude-code", "--no-workspace-context", "--no-environment", "--allow-limited", "--allow-divergent", legacyID}
+	runResume := func(extra ...string) (resumeReport, error) {
+		t.Helper()
+		var output bytes.Buffer
+		err := runSessionWithStreams(append(append([]string{"resume"}, extra...), args[1:]...), strings.NewReader("passphrase\n"), &output, io.Discard)
+		var report resumeReport
+		if err == nil {
+			err = json.Unmarshal(output.Bytes(), &report)
+		}
+		return report, err
+	}
+	targetDir := target.SidecarDir(projectRoot, nativeID)
+	preview, err := runResume("--preview")
+	if err != nil || preview.Sidecar != nil {
+		t.Fatalf("preview = %+v, %v", preview, err)
+	}
+	if _, err := os.Stat(targetDir); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("preview wrote the companion folder: %v", err)
+	}
+	report, err := runResume()
+	if err != nil || report.Sidecar == nil || *report.Sidecar != (sidecarReport{State: "restored", Files: 3, Written: 3}) {
+		t.Fatalf("restore = %+v (%+v), %v", report, report.Sidecar, err)
+	}
+	for name, body := range companion {
+		got, err := os.ReadFile(filepath.Join(targetDir, filepath.FromSlash(name)))
+		if err != nil || string(got) != body {
+			t.Fatalf("restored %s = %q, %v", name, got, err)
+		}
+	}
+	data, err := target.ReadSession(adapter.SessionRef{NativeID: nativeID, ProjectPath: projectRoot})
+	if err != nil || !bytes.Contains(bytes.Join(data.Records, nil), []byte("sidecar-parent-marker")) {
+		t.Fatalf("parent session was not restored beside its folder: %v", err)
+	}
+
+	// Restoring again replaces a changed file, keeps an identical one and never
+	// deletes a file that only this PC has.
+	changed := filepath.Join(targetDir, "tool-results", "toolu_1.txt")
+	if err := os.WriteFile(changed, []byte("edited here"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	localOnly := filepath.Join(targetDir, "subagents", "agent-local.jsonl")
+	if err := os.WriteFile(localOnly, []byte("local\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := parseResumeOptions([]string{"--sidecar-backup", "relative", legacyID}); err == nil {
+		t.Fatal("a relative --sidecar-backup must be rejected")
+	}
+	// The GUI passes a new folder in its recovery area; replaced files land there.
+	backup := filepath.Join(t.TempDir(), "journal.companion")
+	again, err := runResume("--replace-existing", "--sidecar-backup", backup)
+	if err != nil || again.Sidecar == nil || *again.Sidecar != (sidecarReport{State: "restored", Files: 3, Written: 1, Unchanged: 2, BackedUp: 1}) {
+		t.Fatalf("second restore = %+v, %v", again.Sidecar, err)
+	}
+	if got, _ := os.ReadFile(changed); string(got) != "saved tool output" {
+		t.Fatalf("changed file = %q", got)
+	}
+	if got, _ := os.ReadFile(filepath.Join(backup, "tool-results", "toolu_1.txt")); string(got) != "edited here" {
+		t.Fatalf("backup of the replaced file = %q", got)
+	}
+	if got, _ := os.ReadFile(localOnly); string(got) != "local\n" {
+		t.Fatalf("local-only file = %q", got)
+	}
+
+	// A backup pushed by an older release has no sidecar object.
+	if err := os.Remove(filepath.Join(remoteRoot, filepath.FromSlash(sidecarKey))); err != nil {
+		t.Fatal(err)
+	}
+	absent, err := runResume("--replace-existing")
+	if err != nil || absent.Sidecar == nil || absent.Sidecar.State != "absent" {
+		t.Fatalf("restore without sidecar = %+v, %v", absent.Sidecar, err)
+	}
+}
diff --git a/cmd/ctxhop/sidecar.go b/cmd/ctxhop/sidecar.go
new file mode 100644
index 0000000..a97fc89
--- /dev/null
+++ b/cmd/ctxhop/sidecar.go
@@ -0,0 +1,56 @@
+package main
+
+import (
+	"context"
+	"crypto/ecdh"
+	"errors"
+	"fmt"
+	"sort"
+
+	"github.com/CCCCY-ci/ctxhop/internal/crypto"
+	"github.com/CCCCY-ci/ctxhop/internal/remote"
+	"github.com/CCCCY-ci/ctxhop/internal/syncer"
+)
+
+// sidecarReport tells the caller whether the files kept beside the session
+// (Claude Code: subagent transcripts and saved tool results) came back.
+// State is "restored" or "absent" (the source pushed no sidecar, for example
+// with an older release).
+type sidecarReport struct {
+	State     string `json:"state"`
+	Files     int    `json:"files"`
+	Written   int    `json:"written"`
+	Unchanged int    `json:"unchanged"`
+	BackedUp  int    `json:"backedUp"`
+}
+
+// restoreSessionSidecar writes the sidecar of the first source device that
+// has one into dir, beside the restored session file. When backupDir is set,
+// local files it replaces are copied there first.
+func restoreSessionSidecar(ctx context.Context, store remote.Remote, identities []*ecdh.PrivateKey, identifierKey []byte, projectID, nativeID string, devices []string, dir, backupDir string) (sidecarReport, error) {
+	sessionID, err := crypto.SessionID(identifierKey, projectID, nativeID)
+	if err != nil {
+		return sidecarReport{}, err
+	}
+	ordered := append([]string(nil), devices...)
+	sort.Strings(ordered)
+	for _, device := range ordered {
+		layout, err := syncer.NewObjectLayout(projectID, sessionID, device)
+		if err != nil {
+			return sidecarReport{}, err
+		}
+		files, err := syncer.ReadSidecar(ctx, store, layout, identities)
+		if errors.Is(err, syncer.ErrNoSidecar) {
+			continue
+		}
+		if err != nil {
+			return sidecarReport{}, err
+		}
+		applied, err := syncer.ApplySidecar(dir, files, backupDir)
+		if err != nil {
+			return sidecarReport{}, fmt.Errorf("%w (%d of %d files written)", err, applied.Written, len(files))
+		}
+		return sidecarReport{State: "restored", Files: len(files), Written: applied.Written, Unchanged: applied.Unchanged, BackedUp: applied.BackedUp}, nil
+	}
+	return sidecarReport{State: "absent"}, nil
+}
