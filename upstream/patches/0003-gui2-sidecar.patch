+func TestSidecarRejectsUnsafeArchives(t *testing.T) {
+	for _, name := range []string{"../escape.txt", "/abs.txt", "a/../../b", "C:/x.txt", "a\\b.txt", "sub/CON", "nul.txt", "trailing.", "space ", "a//b", "./a", "com1.log", "x:stream", ""} {
