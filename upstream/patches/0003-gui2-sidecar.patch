+func writeSidecarFixture(t *testing.T, dir string, files map[string]string) {
+	t.Helper()
+	for name, body := range files {
+		path := filepath.Join(dir, filepath.FromSlash(name))
+		if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path, []byte(body), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// linkDir makes a directory link, falling back to a junction on Windows where
+// symlinks need a privilege. It skips the test when neither is available.
+func linkDir(t *testing.T, target, link string) {
+	t.Helper()
+	if err := os.Symlink(target, link); err == nil {
+		return
+	}
+	if runtime.GOOS == "windows" {
+		if err := exec.Command("cmd", "/c", "mklink", "/J", link, target).Run(); err == nil {
+			return
+		}
+	}
+	t.Skip("directory links are unavailable")
+}
+
+func TestSidecarRoundTripThroughEncryptedStore(t *testing.T) {
+	ctx := context.Background()
+	source := t.TempDir()
+	writeSidecarFixture(t, source, map[string]string{
+		"subagents/agent-a1.jsonl":     "{\"type\":\"user\",\"text\":\"SIDECAR-MARKER\"}\n",
+		"subagents/agent-a1.meta.json": "{\"agentType\":\"worker\"}",
+		"tool-results/result 1.txt":    "saved tool output",
+		"top.json":                     "{}",
+	})
+	outside := t.TempDir()
+	writeSidecarFixture(t, outside, map[string]string{"secret.txt": "OUTSIDE-SECRET"})
+	linkDir(t, outside, filepath.Join(source, "linked"))
+	files, err := CaptureSidecar(ctx, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var names []string
+	for _, file := range files {
+		names = append(names, file.Path)
+	}
+	want := []string{"subagents/agent-a1.jsonl", "subagents/agent-a1.meta.json", "tool-results/result 1.txt", "top.json"}
+	if len(names) != len(want) {
+		t.Fatalf("captured %v, want %v (links are not followed)", names, want)
+	}
+	for index := range want {
+		if names[index] != want[index] {
+			t.Fatalf("captured %v, want %v", names, want)
+		}
+	}
+
+	store, err := remote.NewDir(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	dataKey := crypto.NewDataKey()
+	defer dataKey.Close()
+	public, err := dataKey.IdentityPublic()
+	if err != nil {
+		t.Fatal(err)
+	}
+	identity, err := dataKey.IdentityPrivate()
+	if err != nil {
+		t.Fatal(err)
+	}
+	layout, err := NewObjectLayout("p0000000000000000000000000", "s0000000000000000000000000", "devicea")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := ReadSidecar(ctx, store, layout, []*ecdh.PrivateKey{identity}); !errors.Is(err, ErrNoSidecar) {
+		t.Fatalf("missing sidecar = %v, want ErrNoSidecar", err)
+	}
+	if err := PutSidecar(ctx, store, public, layout, files); err != nil {
+		t.Fatal(err)
+	}
+	key, _ := layout.SidecarKey()
+	reader, err := store.Get(ctx, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var sealed bytes.Buffer
+	sealed.ReadFrom(reader)
+	reader.Close()
+	if bytes.Contains(sealed.Bytes(), []byte("SIDECAR-MARKER")) || bytes.Contains(sealed.Bytes(), []byte("agent-a1")) {
+		t.Fatal("sidecar object is not encrypted")
+	}
+	read, err := ReadSidecar(ctx, store, layout, []*ecdh.PrivateKey{identity})
+	if err != nil || len(read) != len(files) {
+		t.Fatalf("read sidecar = %d files, %v", len(read), err)
+	}
+
+	target := filepath.Join(t.TempDir(), "session-id")
+	writeSidecarFixture(t, target, map[string]string{"tool-results/result 1.txt": "local different", "local-only.txt": "keep me", "top.json": "{}"})
+	backup := filepath.Join(t.TempDir(), "backup")
+	result, err := ApplySidecar(target, read, backup)
+	if err != nil || result.Written != 3 || result.Unchanged != 1 || result.BackedUp != 1 {
+		t.Fatalf("apply = %+v, %v", result, err)
+	}
+	for name, body := range map[string]string{"subagents/agent-a1.jsonl": "{\"type\":\"user\",\"text\":\"SIDECAR-MARKER\"}\n", "tool-results/result 1.txt": "saved tool output", "local-only.txt": "keep me"} {
+		got, err := os.ReadFile(filepath.Join(target, filepath.FromSlash(name)))
+		if err != nil || string(got) != body {
+			t.Fatalf("%s = %q, %v", name, got, err)
+		}
+	}
+	if got, err := os.ReadFile(filepath.Join(backup, "tool-results", "result 1.txt")); err != nil || string(got) != "local different" {
+		t.Fatalf("backup of the replaced file = %q, %v", got, err)
+	}
+	if _, err := ApplySidecar(target, read, backup); !errors.Is(err, ErrUnsafeSidecarPath) {
+		t.Fatalf("existing backup folder = %v", err)
+	}
+	again, err := ApplySidecar(target, read, "")
+	if err != nil || again.Written != 0 || again.Unchanged != 4 {
+		t.Fatalf("second apply = %+v, %v", again, err)
+	}
+	empty, err := CaptureSidecar(ctx, filepath.Join(t.TempDir(), "missing"))
+	if err != nil || len(empty) != 0 {
+		t.Fatalf("missing folder = %v, %v", empty, err)
+	}
