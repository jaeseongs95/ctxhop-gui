+		t.Fatal(err)
+	}
+	if read, err := ReadSidecar(ctx, store, layout, []*ecdh.PrivateKey{identity}); err != nil || len(read) != 0 {
+		t.Fatalf("empty sidecar = %v, %v", read, err)
+	}
+}
