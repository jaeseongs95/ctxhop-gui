+		writer.SetComment(comment)
+		writer.Close()
+		return buffer.Bytes()
+	}
+	cases := map[string][]byte{
+		"traversal":         build(sidecarFormat, "../escape.txt"),
+		"case duplicate":    build(sidecarFormat, "a.txt", "A.txt"),
+		"file and folder":   build(sidecarFormat, "a", "a/b.txt"),
+		"folder entry":      build(sidecarFormat, "dir/"),
+		"unknown format":    build("other", "a.txt"),
+		"drive letter name": build(sidecarFormat, "C:/a.txt"),
+	}
+	for label, data := range cases {
+		if _, err := ParseSidecar(data); err == nil {
+			t.Errorf("%s: ParseSidecar accepted it", label)
+		}
+	}
+	if _, err := ParseSidecar([]byte("not a zip")); !errors.Is(err, ErrInvalidSidecar) {
+		t.Errorf("garbage = %v", err)
+	}
+	ok, err := ParseSidecar(build(sidecarFormat, "sub/a.txt"))
+	if err != nil || len(ok) != 1 {
+		t.Fatalf("valid archive = %v, %v", ok, err)
+	}
+}
+
+func TestApplySidecarRefusesLinkedFolders(t *testing.T) {
+	outside := t.TempDir()
+	target := filepath.Join(t.TempDir(), "session-id")
+	if err := os.Mkdir(target, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	linkDir(t, outside, filepath.Join(target, "subagents"))
+	_, err := ApplySidecar(target, []SidecarFile{{Path: "subagents/agent.jsonl", Content: []byte("x")}}, "")
+	if !errors.Is(err, ErrUnsafeSidecarPath) {
+		t.Fatalf("apply through a link = %v", err)
+	}
+	if entries, _ := os.ReadDir(outside); len(entries) != 0 {
+		t.Fatal("apply wrote through a linked folder")
+	}
+	linkedRoot := filepath.Join(t.TempDir(), "linked-session")
+	linkDir(t, outside, linkedRoot)
+	if _, err := ApplySidecar(linkedRoot, []SidecarFile{{Path: "a.txt", Content: []byte("x")}}, ""); !errors.Is(err, ErrUnsafeSidecarPath) {
+		t.Fatalf("apply into a linked session folder = %v", err)
+	}
+	if _, err := CaptureSidecar(context.Background(), linkedRoot); !errors.Is(err, ErrUnsafeSidecarPath) {
+		t.Fatalf("capture of a linked session folder = %v", err)
+	}
+}
