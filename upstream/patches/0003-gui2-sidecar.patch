+	for _, name := range []string{"subagents/agent-a1.jsonl", "tool-results/hook-1-additionalContext.txt", "한글 파일.txt", "a.b.c"} {
+		if !ValidSidecarPath(name) {
+			t.Errorf("ValidSidecarPath(%q) = false", name)
+		}
